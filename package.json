{
  "name": "lab-creatures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src scripts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "build:model": "node scripts/build-model.mjs",
    "build:monster": "node scripts/build-monster.mjs",
    "export:monster": "node --experimental-strip-types scripts/export-monster.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "test:physics": "node --experimental-strip-types scripts/verify-physics.mjs",
    "test:monster": "node --experimental-strip-types scripts/verify-monster.mjs",
    "test:feeding": "node --experimental-strip-types scripts/verify-feeding.mjs",
    "test:performance": "node --experimental-strip-types scripts/verify-performance.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:probes": "node --experimental-strip-types scripts/verify-probes.mjs",
    "test:variants": "node --experimental-strip-types scripts/verify-variants.mjs",
    "build:variants": "node scripts/build-monster.mjs brood && node scripts/build-monster.mjs reed && node scripts/build-monster.mjs crown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/delaunator": "^5.0.3",
    "@types/three": "^0.185.4",
    "eslint": "^10.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "three": "^0.185.0"
  }
}
